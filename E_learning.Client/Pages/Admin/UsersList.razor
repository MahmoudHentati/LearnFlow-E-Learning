@page "/admin/users"
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject HttpClient Http
@inject IDialogService DialogService

<PageTitle>Gestion utilisateurs</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Style="font-weight:700;">Gestion des utilisateurs</MudText>
            </div>
            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary ml-11">Listes des utilisateurs par rôle</MudText>
        </div>
        <div class="d-flex align-center gap-4">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small" Class="font-weight-bold">
                @GetFilteredUsers().Count() utilisateurs
            </MudChip>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="OpenCreateDialogAsync"
                       Class="py-2 px-4"
                       Style="border-radius:4px;">
                NOUVEL UTILISATEUR
            </MudButton>
        </div>
    </div>

    <MudPaper Elevation="0" Outlined="true" Square="false" Style="border-radius:4px;" Class="pa-4 mb-4">
        <div class="d-flex justify-space-between align-center mb-4">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
                <MudText Typo="Typo.button">CRITERES DE RECHERCHE</MudText>
            </div>
            @if (!string.IsNullOrWhiteSpace(_searchText))
            {
                <MudButton StartIcon="@Icons.Material.Filled.RestartAlt"
                           Size="Size.Small"
                           OnClick="@(() => _searchText = string.Empty)"
                           Color="Color.Secondary">
                    REINITIALISER
                </MudButton>
            }
        </div>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTabs Rounded="true" Border="true" ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="OnTabChangedAsync">
                    <MudTabPanel Text="Admins" />
                    <MudTabPanel Text="Students" />
                    <MudTabPanel Text="Instructors" />
                </MudTabs>
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Rechercher par nom ou email..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Style="border-radius:4px;" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Square="false" Style="border-radius:4px;">
        @if (_isLoading)
        {
            <div class="d-flex justify-center pa-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="ma-4">@_errorMessage</MudAlert>
        }
        else
        {
            <MudTable Items="GetFilteredUsers()"
                      Hover="true"
                      Dense="true"
                      Striped="true"
                      Breakpoint="Breakpoint.Sm"
                      RowsPerPage="10">
                <HeaderContent>
                    <MudTh>Nom complet</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Rôle</MudTh>
                    <MudTh>Actif</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nom">
                        <MudText Style="font-weight:700;">@($"{context.FirstName} {context.LastName}")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Rôle">@context.Role</MudTd>
                    <MudTd DataLabel="Actif">
                        <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Variant="Variant.Filled" Size="Size.Small">
                            @(context.IsActive ? "Oui" : "Non")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="() => OpenEditDialogAsync(context.Id)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context.Id)" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2">Aucun utilisateur trouve.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager RowsPerPageString="Lignes par page:" />
                </PagerContent>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@code {
    private const string AdminRole = AppRoles.Admin;
    private const string StudentRole = AppRoles.Student;
    private const string InstructorRole = AppRoles.Instructor;

    private readonly Dictionary<string, List<AdminUserDto>> _usersByRole = new()
    {
        [AdminRole] = [],
        [StudentRole] = [],
        [InstructorRole] = []
    };

    private int _activeTabIndex;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _searchText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentRoleAsync();
    }

    private string CurrentRole => _activeTabIndex switch
    {
        0 => AdminRole,
        1 => StudentRole,
        _ => InstructorRole
    };

    private async Task OnTabChangedAsync(int activeTabIndex)
    {
        _activeTabIndex = activeTabIndex;
        await LoadCurrentRoleAsync();
    }

    private async Task LoadCurrentRoleAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var role = CurrentRole;
            var result = await Http.GetFromJsonAsync<List<AdminUserDto>>($"api/users/by-role/{role}");
            _usersByRole[role] = result ?? [];
        }
        catch
        {
            _errorMessage = "Impossible de charger la liste des utilisateurs.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<AdminUserDto> GetFilteredUsers()
    {
        var users = _usersByRole[CurrentRole].AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            users = users.Where(u =>
                u.FirstName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || u.LastName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || u.Email.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
        }

        return users.OrderBy(u => u.LastName).ThenBy(u => u.FirstName);
    }

    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters
        {
            { nameof(UserEditorDialog.DefaultRole), CurrentRole }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<UserEditorDialog>("Nouvel utilisateur", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadCurrentRoleAsync();
        }
    }

    private async Task OpenEditDialogAsync(string id)
    {
        var parameters = new DialogParameters
        {
            { nameof(UserEditorDialog.UserId), id },
            { nameof(UserEditorDialog.DefaultRole), CurrentRole }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<UserEditorDialog>("Modifier utilisateur", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadCurrentRoleAsync();
        }
    }

    private async Task DeleteAsync(string id)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Confirmation",
            "Voulez-vous vraiment supprimer cet utilisateur ?",
            yesText: "Supprimer",
            cancelText: "Annuler");

        if (confirm != true)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/users/{id}");
            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = "Suppression impossible.";
                return;
            }

            _usersByRole[CurrentRole].RemoveAll(u => u.Id == id);
        }
        catch
        {
            _errorMessage = "Erreur pendant la suppression.";
        }
    }
}
