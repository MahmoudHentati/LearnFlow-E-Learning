@page "/admin/formations"
@attribute [Authorize(Roles = "Admin,SUPERADMIN")]
@using E_learning.Models.Helpers
@inject HttpClient Http
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>Liste des formations</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Style="font-weight:700;">Formations</MudText>
            </div>
            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary ml-11">Liste des formations disponibles</MudText>
        </div>
        <div class="d-flex align-center gap-4">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small" Class="font-weight-bold">
                @FilteredFormations.Count formations
            </MudChip>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialogAsync"
                       Class="py-2 px-4"
                       Style="border-radius:4px;">
                NOUVELLE FORMATION
            </MudButton>
        </div>
    </div>

    <MudPaper Elevation="0" Outlined="true" Square="false" Style="border-radius:4px;" Class="pa-4 mb-4">
        <div class="d-flex justify-space-between align-center mb-4">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
                <MudText Typo="Typo.button">CRITERES DE RECHERCHE</MudText>
            </div>
            @if (!string.IsNullOrWhiteSpace(_searchText))
            {
                <MudButton StartIcon="@Icons.Material.Filled.RestartAlt"
                           Size="Size.Small"
                           OnClick="@(() => _searchText = string.Empty)"
                           Color="Color.Secondary">
                    REINITIALISER
                </MudButton>
            }
        </div>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Rechercher titre, categorie, sous-categorie ou formateur..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Style="border-radius:4px;" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Square="false" Style="border-radius:4px;">
    @if (_isLoading)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="ma-4">@_errorMessage</MudAlert>
    }
    else
    {
        <MudTable Items="FilteredFormations" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm" RowsPerPage="10">
            <HeaderContent>
                <MudTh>Titre</MudTh>
                <MudTh>Formateur</MudTh>
                <MudTh>Catégorie</MudTh>
                <MudTh>Sous-catégorie</MudTh>
                <MudTh>Difficulté</MudTh>
                <MudTh>Statut</MudTh>
                <MudTh>Date création</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Titre">@context.Titre</MudTd>
                <MudTd DataLabel="Formateur">@(string.IsNullOrWhiteSpace(context.FormateurNom) ? "-" : context.FormateurNom)</MudTd>
                <MudTd DataLabel="Catégorie">@(context.SousCategorie?.Categorie?.Nom ?? "-")</MudTd>
                <MudTd DataLabel="Sous-catégorie">@(context.SousCategorie?.Nom ?? "-")</MudTd>
                <MudTd DataLabel="Difficulté">@context.Difficulte</MudTd>
                <MudTd DataLabel="Statut">@FormationStatusHelper.GetDisplayLabel(context.Statut)</MudTd>
                <MudTd DataLabel="Date création">@(context.DateCreation?.ToString("yyyy-MM-dd") ?? "-")</MudTd>
                <MudTd DataLabel="Actions">
                    <div class="actions-inline">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Secondary"
                                       Size="Size.Small"
                                       OnClick="() => OpenDetails(context.Id)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="() => OpenEditDialogAsync(context.Id)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="() => DeleteAsync(context.Id)" />
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">Aucune formation trouvée.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="Lignes par page:" />
            </PagerContent>
        </MudTable>
    }
    </MudPaper>
</MudContainer>

<style>
    .actions-inline {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }
</style>

@code {
    private List<FormationDTO> _formations = [];
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _searchText = string.Empty;

    private List<FormationDTO> FilteredFormations =>
        _formations
            .Where(f =>
                string.IsNullOrWhiteSpace(_searchText)
                || (f.Titre?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                || (f.FormateurNom?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                || (f.SousCategorie?.Nom?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                || (f.SousCategorie?.Categorie?.Nom?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderBy(f => f.Titre)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await Http.GetFromJsonAsync<List<FormationDTO>>("api/formation");
            _formations = result ?? [];
        }
        catch
        {
            _errorMessage = "Impossible de charger la liste des formations.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<FormationEditorDialog>("Nouvelle formation", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenEditDialogAsync(int id)
    {
        var parameters = new DialogParameters
        {
            { nameof(FormationEditorDialog.FormationId), id }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<FormationEditorDialog>("Modifier formation", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(int id)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Confirmation",
            "Voulez-vous vraiment supprimer cette formation ?",
            yesText: "Supprimer",
            cancelText: "Annuler");

        if (confirm != true)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/formation/{id}");
            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = "Suppression impossible.";
                return;
            }

            _formations.RemoveAll(f => f.Id == id);
        }
        catch
        {
            _errorMessage = "Erreur pendant la suppression.";
        }
    }

    private void OpenDetails(int id)
    {
        NavigationManager.NavigateTo($"/admin/formations/{id}");
    }
}
