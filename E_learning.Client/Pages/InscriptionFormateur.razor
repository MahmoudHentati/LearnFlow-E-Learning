@page "/inscription/formateur"
@using System.ComponentModel.DataAnnotations
@inject IAuthenticationService AuthenticationService
@inject NavigationManager NavigationManager

<PageTitle>Inscription Formateur à EduLearn</PageTitle>

<div class="iform-page">

    <div class="iform-back-row">
        <a href="/inscription" class="iform-back">←</a>
    </div>

    <div class="iform-wrapper">
        <div class="iform-card iform-card--violet">

            <div class="iform-card__head">
                <div class="iform-card__icon">
                    <MudIcon Icon="@Icons.Material.Filled.CoPresent" />
                </div>
                <div>
                    <h1 class="iform-card__title" style="color:#c084fc;">Inscription Formateur</h1>
                    <p class="iform-card__sub">Remplissez vos informations pour créer votre compte.</p>
                </div>
            </div>

            <EditForm Model="_form" OnValidSubmit="HandleRegisterAsync">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger mb-3">@_errorMessage</div>
                }

                <!-- Nom / Prénom -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label class="iform-label">Nom</label>
                        <div class="iform-field">
                            <span class="iform-field__icon">
                                <MudIcon Icon="@Icons.Material.Filled.Person" />
                            </span>
                            <input type="text" class="iform-input" @bind="_form.LastName" />
                        </div>
                        <ValidationMessage For="@(() => _form.LastName)" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="iform-label">Prénom</label>
                        <div class="iform-field">
                            <span class="iform-field__icon">
                                <MudIcon Icon="@Icons.Material.Filled.Edit" />
                            </span>
                            <input type="text" class="iform-input" @bind="_form.FirstName" />
                        </div>
                        <ValidationMessage For="@(() => _form.FirstName)" />
                    </div>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label class="iform-label">Adresse e-mail</label>
                    <div class="iform-field">
                        <span class="iform-field__icon">
                            <MudIcon Icon="@Icons.Material.Filled.Email" />
                        </span>
                        <input type="email" class="iform-input" @bind="_form.Email" />
                    </div>
                    <ValidationMessage For="@(() => _form.Email)" />
                </div>

                <!-- Adresse -->
                <div class="mb-3">
                    <label class="iform-label">Adresse postale</label>
                    <div class="iform-field">
                        <span class="iform-field__icon">
                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
                        </span>
                        <input type="text" class="iform-input" />
                    </div>
                </div>

                <!-- Mot de passe -->
                <div class="mb-3">
                    <label class="iform-label">Mot de passe</label>
                    <div class="iform-field">
                        <span class="iform-field__icon">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" />
                        </span>
                        <div style="position:relative; width:100%;"><input type="@PasswordType" class="iform-input" @bind="_form.Password" @bind:event="oninput" /><button type="button" @onclick="TogglePassword" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:inherit;"><MudIcon Icon="@PasswordIcon" Size="Size.Small"/></button></div>
                    </div>
                    <ValidationMessage For="@(() => _form.Password)" />

                    <!-- Critères du mot de passe -->
                    <ul class="pwd-criteria">
                        <li class="@(HasUppercase ? "pwd-ok" : "pwd-no")">
                            <span class="pwd-icon">@(HasUppercase ? "✓" : "×")</span>
                            Au moins une lettre majuscule
                        </li>
                        <li class="@(HasDigit ? "pwd-ok" : "pwd-no")">
                            <span class="pwd-icon">@(HasDigit ? "✓" : "×")</span>
                            Au moins un chiffre
                        </li>
                        <li class="@(HasSpecial ? "pwd-ok" : "pwd-no")">
                            <span class="pwd-icon">@(HasSpecial ? "✓" : "×")</span>
                            Au moins un caractère spécial
                        </li>
                    </ul>
                </div>

                <!-- Confirm -->
                <div class="mb-3">
                    <label class="iform-label">Confirmer le mot de passe</label>
                    <div class="iform-field">
                        <span class="iform-field__icon">
                            <MudIcon Icon="@Icons.Material.Filled.LockReset" />
                        </span>
                        <div style="position:relative; width:100%;"><input type="@PasswordType" class="iform-input" @bind="_form.ConfirmPassword" /><button type="button" @onclick="TogglePassword" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:inherit;"><MudIcon Icon="@PasswordIcon" Size="Size.Small"/></button></div>
                    </div>
                    <ValidationMessage For="@(() => _form.ConfirmPassword)" />
                </div>

                <div class="iform-sep">
                    <span style="color:#c084fc;">Carrière professionnelle</span>
                </div>

                <!-- Expérience -->
                <div class="mb-3">
                    <label class="iform-label">Années d'expérience</label>
                    <div class="iform-field">
                        <span class="iform-field__icon">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />
                        </span>
                        <select class="iform-input iform-select" @bind="_form.Experience">
                            <option value="" disabled selected>-- Sélectionnez --</option>
                            <option>Moins de 2 ans</option>
                            <option>2 à 5 ans</option>
                            <option>5 à 10 ans</option>
                            <option>10 à 20 ans</option>
                            <option>Plus de 20 ans</option>
                        </select>
                    </div>
                </div>

                <!-- Poste -->
                <div class="mb-3">
                    <label class="iform-label">Poste actuel</label>
                    <div class="iform-field">
                        <span class="iform-field__icon">
                            <MudIcon Icon="@Icons.Material.Filled.Work" />
                        </span>
                        <input type="text" class="iform-input" @bind="_form.CurrentPosition" />
                    </div>
                </div>

                <!-- Biographie FIX -->
                <div class="mb-3">
                    <label class="iform-label">Biographie</label>
                    <div class="iform-field">
                        <span class="iform-field__icon">
                            <MudIcon Icon="@Icons.Material.Filled.Description" />
                        </span>
                        <textarea class="iform-input" style="height:90px; padding-top:12px;" @bind="_form.Bio"></textarea>
                    </div>
                </div>

                <div class="iform-sep">
                    <span style="color:#c084fc;">Diplômes & Certifications</span>
                </div>

                <!-- Niveau -->
                <div class="mb-3">
                    <label class="iform-label">Niveau d'études</label>
                    <div class="iform-field">
                        <span class="iform-field__icon">
                            <MudIcon Icon="@Icons.Material.Filled.School" />
                        </span>
                        <select class="iform-input iform-select" @bind="_form.EducationLevel">
                            <option value="" disabled selected></option>
                            <option>Baccalauréat</option>
                            <option>Licence (Bac+3)</option>
                            <option>Master (Bac+5)</option>
                            <option>Doctorat / PhD</option>
                            <option>HDR</option>
                            <option>Ingénieur d'Etat</option>
                            <option>Autre</option>
                        </select>
                    </div>
                </div>

                <!-- Spécialité FIX -->
                <div class="mb-3">
                    <label class="iform-label">Spécialité</label>
                    <div class="iform-field">
                        <span class="iform-field__icon">
                            <MudIcon Icon="@Icons.Material.Filled.Science" />
                        </span>
                        <input type="text" class="iform-input" @bind="_form.Speciality" />
                    </div>
                </div>

                <!-- Certifications FIX -->
                <div class="mb-3">
                    <label class="iform-label">Certifications</label>
                    <div class="iform-field">
                        <span class="iform-field__icon">
                            <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" />
                        </span>
                        <textarea class="iform-input" style="height:80px; padding-top:12px;" @bind="_form.Certifications"></textarea>
                    </div>
                </div>

                <!-- Upload -->
                <div class="mb-4">
                    <label class="iform-label">Attestations / CV</label>
                    <label class="iform-filedrop iform-filedrop--violet" for="f-diplome">
                        <span class="iform-filedrop__icon"><MudIcon Icon="@Icons.Material.Filled.AttachFile" /></span>
                        <span>Joindre des documents (PDF, JPG)</span>
                        <input type="file" id="f-diplome" accept=".pdf,.jpg,.jpeg,.png" multiple class="iform-filedrop__input" />
                    </label>
                </div>

                <!-- Bouton centré -->
                <div style="text-align:center;">
                    <button type="submit" class="iform-btn iform-btn--violet" disabled="@_isLoading">
                        @(_isLoading ? "Création en cours..." : "Créer mon compte Formateur")
                    </button>
                </div>

            </EditForm>

            <p class="iform-footer">
                Déjà inscrit ? <a href="/login">Se connecter</a>
            </p>

        </div>
    </div>

    @code {
        private readonly InstructorRegistrationForm _form = new();
        private bool _isLoading;
        private bool _showPassword;
        private string PasswordType => _showPassword ? "text" : "password";
        private string PasswordIcon => _showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        private void TogglePassword() => _showPassword = !_showPassword;

        private string? _errorMessage;

        private bool HasUppercase  => _form.Password.Any(char.IsUpper);
        private bool HasDigit      => _form.Password.Any(char.IsDigit);
        private bool HasSpecial    => _form.Password.Any(c => !char.IsLetterOrDigit(c));

        private async Task HandleRegisterAsync()
        {
            _isLoading = true;
            _errorMessage = null;

            var registerRequest = new RegisterRequest
            {
                FirstName = _form.FirstName,
                LastName = _form.LastName,
                Email = _form.Email,
                Password = _form.Password,
                Role = AppRoles.Instructor
            };

            var isRegistered = await AuthenticationService.RegisterAsync(registerRequest);
            _isLoading = false;

            if (!isRegistered)
            {
                _errorMessage = "Inscription échouée.";
                return;
            }

            NavigationManager.NavigateTo("/login?registered=true&pendingApproval=true");
        }

        private sealed class InstructorRegistrationForm
        {
            [Required] public string FirstName { get; set; } = "";
            [Required] public string LastName { get; set; } = "";
            [Required][EmailAddress] public string Email { get; set; } = "";
            [Required][MinLength(6)] public string Password { get; set; } = "";
            [Required][Compare(nameof(Password))] public string ConfirmPassword { get; set; } = "";
            [Required] public string Speciality { get; set; } = "";

            public string Experience { get; set; } = "";
            public string CurrentPosition { get; set; } = "";
            public string Bio { get; set; } = "";
            public string EducationLevel { get; set; } = "";
            public string Certifications { get; set; } = "";
        }
    }
</div>
