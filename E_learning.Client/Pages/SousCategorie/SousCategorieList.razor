@page "/admin/sous-categories"
@attribute [Authorize(Roles = "Admin,SUPERADMIN")]
@inject HttpClient Http
@inject IDialogService DialogService

<PageTitle>Sous-catégories</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Style="font-weight:700;">Gestion des sous-categories</MudText>
            </div>
            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary ml-11">Creer, modifier et supprimer les sous-categories</MudText>
        </div>
        <div class="d-flex align-center gap-4">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small" Class="font-weight-bold">
                @FilteredSousCategories.Count sous-categories
            </MudChip>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialogAsync"
                       Class="py-2 px-4"
                       Style="border-radius:4px;">
                NOUVELLE SOUS-CATEGORIE
            </MudButton>
        </div>
    </div>

    <MudPaper Elevation="0" Outlined="true" Square="false" Style="border-radius:4px;" Class="pa-4 mb-4">
        <div class="d-flex justify-space-between align-center mb-4">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
                <MudText Typo="Typo.button">CRITERES DE RECHERCHE</MudText>
            </div>
            @if (!string.IsNullOrWhiteSpace(_searchText))
            {
                <MudButton StartIcon="@Icons.Material.Filled.RestartAlt"
                           Size="Size.Small"
                           OnClick="@(() => _searchText = string.Empty)"
                           Color="Color.Secondary">
                    REINITIALISER
                </MudButton>
            }
        </div>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Rechercher par nom, categorie ou description..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Style="border-radius:4px;" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Square="false" Style="border-radius:4px;">
    @if (_isLoading)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="ma-4">@_errorMessage</MudAlert>
    }
    else
    {
        <MudTable Items="FilteredSousCategories" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm" RowsPerPage="10">
            <HeaderContent>
                <MudTh>Nom</MudTh>
                <MudTh>Catégorie</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nom">@context.Nom</MudTd>
                <MudTd DataLabel="Catégorie">@(context.Categorie?.Nom ?? "-")</MudTd>
                <MudTd DataLabel="Description">@context.Description</MudTd>
                <MudTd DataLabel="Actions">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="() => OpenEditDialogAsync(context.Id)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="() => DeleteAsync(context.Id)" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">Aucune sous-categorie trouvee.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="Lignes par page:" />
            </PagerContent>
        </MudTable>
    }
    </MudPaper>
</MudContainer>

@code {
    private List<SousCategorieDTO> _sousCategories = [];
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _searchText = string.Empty;

    private List<SousCategorieDTO> FilteredSousCategories =>
        _sousCategories
            .Where(sc =>
                string.IsNullOrWhiteSpace(_searchText)
                || (sc.Nom?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                || (sc.Description?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                || (sc.Categorie?.Nom?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderBy(sc => sc.Nom)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _sousCategories = await Http.GetFromJsonAsync<List<SousCategorieDTO>>("api/souscategories") ?? [];
        }
        catch
        {
            _errorMessage = "Impossible de charger les sous-catégories.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<SousCategorieEditorDialog>("Nouvelle sous-catégorie", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenEditDialogAsync(int id)
    {
        var parameters = new DialogParameters { { nameof(SousCategorieEditorDialog.SousCategorieId), id } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<SousCategorieEditorDialog>("Modifier sous-catégorie", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(int id)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Confirmation",
            "Voulez-vous vraiment supprimer cette sous-categorie ?",
            yesText: "Supprimer",
            cancelText: "Annuler");

        if (confirm != true)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/souscategories/{id}");
            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = "Suppression impossible.";
                return;
            }

            _sousCategories.RemoveAll(x => x.Id == id);
        }
        catch
        {
            _errorMessage = "Erreur pendant la suppression.";
        }
    }
}
