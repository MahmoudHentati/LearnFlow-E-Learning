                                                                </div>
                                                            </MudItem>
                                                            <MudItem xs="12" Class="d-flex gap-2">
                                                                <MudButton Variant="Variant.Filled" Color="Color.Info" Disabled="_isSavingTest" OnClick="@(() => CreateTestAsync(module))">
                                                                    @(_isSavingTest ? "Création..." : "Créer le test")
                                                                </MudButton>
                                                                <MudButton Variant="Variant.Text" OnClick="CancelTestCreation">Annuler</MudButton>
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudPaper>
                                                }
                                            </MudTabPanel>
                                        </MudTabs>
                                    </MudPaper>
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                    }
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
