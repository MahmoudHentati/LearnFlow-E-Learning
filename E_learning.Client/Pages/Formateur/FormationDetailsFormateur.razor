                                                                                <MudButton Variant="Variant.Text" OnClick="CancelDocumentEdit">Annuler</MudButton>
                                                                            </MudItem>
                                                                        </MudGrid>
                                                                    </MudPaper>
                                                                }
                                                            </MudPaper>
                                                        }
                                                    </div>
                                                }

                                                @if (_activeDocumentModuleId == module.Id)
