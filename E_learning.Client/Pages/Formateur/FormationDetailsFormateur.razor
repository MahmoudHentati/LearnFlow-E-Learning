        => quiz.Questions?.Count ?? 0;

    private async Task SyncAutomaticProgressAsync()
    {
        foreach (var inscription in _inscriptions)
        {
            var automaticProgress = GetAutomaticProgress(inscription);
            if (Math.Abs(inscription.Progression - automaticProgress) < 0.01f)
            {
                continue;
            }

            var dto = new InscriptionDTO
            {
                Id = inscription.Id,
                DateInscription = inscription.DateInscription,
                Progression = automaticProgress,
                EdudiantId = inscription.EdudiantId,
                FormationId = inscription.FormationId
            };

            var response = await Http.PutAsJsonAsync($"api/inscriptions/{inscription.Id}", dto);
            if (response.IsSuccessStatusCode)
            {
                inscription.Progression = automaticProgress;
            }
        }
    }

    private float GetAutomaticProgress(InscriptionDTO inscription)
    {
        var totalQuizzes = Modules.Sum(module => module.Quizzes?.Count ?? 0);
        var totalTests = Modules.Sum(module => module.Tests?.Count ?? 0);
        var totalEvaluations = totalQuizzes + totalTests;

        if (totalEvaluations <= 0)
        {
            return 0;
        }

        var completedQuizzes = _participations
            .Where(participation => participation.InscriptionId == inscription.Id)
            .Select(participation => participation.QuizId)
            .Distinct()
            .Count();

        var completedTests = _rendus
            .Where(rendu => rendu.InscriptionId == inscription.Id)
            .Select(rendu => rendu.TestId)
            .Distinct()
            .Count();

        var completedEvaluations = completedQuizzes + completedTests;
        var progress = (float)completedEvaluations / totalEvaluations * 100f;
        return NormalizeProgress(progress);
    }

