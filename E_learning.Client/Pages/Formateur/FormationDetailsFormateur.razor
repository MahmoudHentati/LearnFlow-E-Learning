                                                                                                        <MudSelectItem Value="@TypeQuestion.FAUX">Faux</MudSelectItem>
                                                                                                    </MudSelect>
                                                                                                </MudItem>
                                                                                                <MudItem xs="12" Class="d-flex gap-2">
                                                                                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isSavingQuestionEdit" OnClick="@(() => SaveQuestionAsync(question))">Enregistrer</MudButton>
                                                                                                    <MudButton Variant="Variant.Text" OnClick="CancelQuestionEdit">Annuler</MudButton>
                                                                                                </MudItem>
                                                                                            </MudGrid>
                                                                                        </MudPaper>
                                                                                    }
                                                                                </MudPaper>
                                                                            }
                                                                        </div>
                                                                    }

