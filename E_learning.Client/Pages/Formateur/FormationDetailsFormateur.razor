        {
            foreach (var option in question.OptionsReponses.ToList())
            {
                await Http.DeleteAsync($"api/optionreponse/{option.Id}");
            }
        }

        var response = await Http.DeleteAsync($"api/questions/{question.Id}");
        if (response.IsSuccessStatusCode)
        {
            quiz.Questions?.Remove(question);
        }
