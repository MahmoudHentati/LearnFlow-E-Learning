                                                                                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => StartQuestionEdit(question))">Modifier</MudButton>
                                                                                        <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteQuestionAsync(quiz, question))">Supprimer</MudButton>
