                                                                            <MudText Typo="Typo.caption" Class="resource-eyebrow">Évaluation</MudText>
                                                                            <MudText Typo="Typo.subtitle1" Class="resource-title">@($"Quiz #{quiz.Id}")</MudText>
                                                                        </div>
                                                                        <MudStack Row="true" Spacing="1" Style="flex-wrap:wrap;">
                                                                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@($"{quiz.DLimite} min")</MudChip>
                                                                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning">@($"Min {quiz.ScoreMinimum}")</MudChip>
                                                                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info">@($"Max {maxScore}")</MudChip>
