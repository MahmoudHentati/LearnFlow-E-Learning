                                                    <MudPaper Class="module-form mt-3 pa-4" Elevation="0">
                                                        <MudText Typo="Typo.subtitle2" Class="mb-2">Nouveau test</MudText>

                                                        @if (!string.IsNullOrWhiteSpace(_testErrorMessage))
                                                        {
                                                            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-3">@_testErrorMessage</MudAlert>
