                                                                    @(_isSavingVideo ? "Création..." : "Créer la vidéo")
                                                                </MudButton>
                                                                <MudButton Variant="Variant.Text" OnClick="CancelVideoCreation">Annuler</MudButton>
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudPaper>
                                                }
                                            </MudTabPanel>

                                            <MudTabPanel Text="Documents">
                                                <div class="module-tab-actions">
                                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Description" OnClick="@(() => StartDocumentCreation(module))">
                                                        Ajouter un document
                                                    </MudButton>
                                                </div>

                                                @if (module.Documents is null || module.Documents.Count == 0)
