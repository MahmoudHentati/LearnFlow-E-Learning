                    option.EstCorrecte = option.Texte.Equals(_editingQuestionCorrectAnswer == TypeQuestion.VRAI ? "Vrai" : "Faux", StringComparison.OrdinalIgnoreCase);
                    await Http.PutAsJsonAsync($"api/optionreponse/{option.Id}", option);
