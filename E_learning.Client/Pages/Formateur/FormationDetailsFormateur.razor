                                                                }
                                                                <div class="resource-actions">
                                                                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => StartTestEdit(test))">Modifier</MudButton>
                                                                    <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteTestAsync(module, test))">Supprimer</MudButton>
                                                                </div>

                                                                @if (_editingTestId == test.Id)
                                                                {
                                                                    <MudPaper Outlined="true" Elevation="0" Class="module-form mt-2 pa-3">
                                                                        @if (!string.IsNullOrWhiteSpace(_editingTestErrorMessage))
