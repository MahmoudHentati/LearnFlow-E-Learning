    private async Task CreateQuestionAsync(QuizDTO quiz)
    {
        _questionErrorMessage = null;

        if (string.IsNullOrWhiteSpace(_questionEnonce))
        {
            _questionErrorMessage = "L'énoncé est obligatoire.";
            return;
        }

        if (_questionBareme < 0)
        {
            _questionErrorMessage = "Le barème est invalide.";
            return;
        }

        _isSavingQuestion = true;

        try
        {
            var questionDto = new QuestionDTO
            {
                Enonce = _questionEnonce.Trim(),
                Bareme = _questionBareme,
                QuizId = quiz.Id,
                Type = _questionCorrectAnswer
            };

            var questionResponse = await Http.PostAsJsonAsync("api/questions", questionDto);
            if (!questionResponse.IsSuccessStatusCode)
            {
                _questionErrorMessage = await ReadErrorAsync(questionResponse, "Impossible de créer la question.");
                return;
            }

            var createdQuestion = await questionResponse.Content.ReadFromJsonAsync<QuestionDTO>();
            if (createdQuestion is null)
            {
                _questionErrorMessage = "La question n'a pas pu être chargée.";
                return;
            }

            var options = new[]
            {
                new OptionResponseDTO { Texte = "Vrai", EstCorrecte = _questionCorrectAnswer == TypeQuestion.VRAI, QuestionId = createdQuestion.Id },
                new OptionResponseDTO { Texte = "Faux", EstCorrecte = _questionCorrectAnswer == TypeQuestion.FAUX, QuestionId = createdQuestion.Id }
            };

            var createdOptions = new List<OptionResponseDTO>();
            foreach (var option in options)
            {
                var optionResponse = await Http.PostAsJsonAsync("api/optionreponse", option);
                if (!optionResponse.IsSuccessStatusCode)
                {
                    _questionErrorMessage = await ReadErrorAsync(optionResponse, "La question a été créée, mais les réponses n'ont pas pu être enregistrées.");
                    return;
                }

                var createdOption = await optionResponse.Content.ReadFromJsonAsync<OptionResponseDTO>();
                if (createdOption is not null)
                {
                    createdOptions.Add(createdOption);
                }
            }

            createdQuestion.OptionsReponses = createdOptions;
            quiz.Questions ??= new List<QuestionDTO>();
            quiz.Questions.Add(createdQuestion);
            _activeQuestionQuizId = null;
        }
        catch
        {
            _questionErrorMessage = "Erreur lors de la création de la question.";
        }
        finally
        {
            _isSavingQuestion = false;
        }
    }

