    private async Task CreateModuleAsync()
    {
        _moduleErrorMessage = null;

        if (_formation is null)
        {
            _moduleErrorMessage = "Formation introuvable.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_newModuleTitle))
        {
            _moduleErrorMessage = "Le titre du module est obligatoire.";
            return;
        }

        if (_newModuleOrder <= 0)
        {
            SetNextModuleOrder();
        }

        _isSavingModule = true;

        try
        {
            var dto = new ModuleDTO
            {
                Titre = _newModuleTitle.Trim(),
                Ordre = _newModuleOrder,
                FormationId = _formation.Id
            };

            var response = await Http.PostAsJsonAsync("api/modules", dto);
            if (!response.IsSuccessStatusCode)
            {
                _moduleErrorMessage = await ReadErrorAsync(response, "Impossible de créer le module.");
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<ModuleDTO>();
            if (created is null)
            {
                _moduleErrorMessage = "Le module n'a pas pu être chargé.";
                return;
            }

            created.Quizzes ??= new List<QuizDTO>();
            created.Tests ??= new List<TestDTO>();
            created.Videos ??= new List<VideoDTO>();
            created.Documents ??= new List<DocumentDTO>();

            _formation.Modules ??= new List<ModuleDTO>();
            _formation.Modules.Add(created);
            _newModuleTitle = string.Empty;
            SetNextModuleOrder();
        }
        catch
        {
            _moduleErrorMessage = "Erreur lors de la création du module.";
        }
        finally
        {
            _isSavingModule = false;
        }
