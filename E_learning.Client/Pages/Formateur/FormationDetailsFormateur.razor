                                                                            <MudItem xs="12" Class="d-flex gap-2">
                                                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isSavingTestEdit" OnClick="@(() => SaveTestAsync(test))">Enregistrer</MudButton>
                                                                                <MudButton Variant="Variant.Text" OnClick="CancelTestEdit">Annuler</MudButton>
