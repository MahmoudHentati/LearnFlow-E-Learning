        => participation.Quiz is null ? $"Quiz {participation.QuizId}" : $"Quiz {participation.QuizId} - min {participation.Quiz.ScoreMinimum}";

    private static Color GetQuizScoreColor(ParticipationQuizDTO participation)
    {
        var minScore = participation.Quiz?.ScoreMinimum ?? 0;
        return participation.Score >= minScore ? Color.Success : Color.Warning;
    }

    private static string FormatQuizScore(ParticipationQuizDTO participation, float maxScore)
        => maxScore > 0 ? $"{participation.Score:0.##} / {maxScore:0.##}" : $"{participation.Score:0.##}";

    private static Color GetRenduNoteColor(float? note)
    {
        if (!note.HasValue)
        {
            return Color.Default;
        }

        return note.Value >= 10 ? Color.Success : Color.Warning;
    }

    private static string FormatRenduNote(float? note)
        => note.HasValue ? $"Note {note.Value:0.##}" : "Non noté";

    private async Task<bool> ConfirmDeleteAsync(string targetLabel)
    {
        var result = await DialogService.ShowMessageBox(
            "Confirmation",
            $"Voulez-vous vraiment supprimer {targetLabel} ?",
            yesText: "Supprimer",
            cancelText: "Annuler");

        return result == true;
    }

    private static string GetFileExtensionLabel(string? url, string fallback)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return fallback;
        }

        try
        {
            var extension = Path.GetExtension(new Uri(url).AbsolutePath).TrimStart('.');
            return string.IsNullOrWhiteSpace(extension) ? fallback : extension.ToUpperInvariant();
        }
        catch
        {
            return fallback;
        }
    }

    private static string GetDownloadFileName(string title, string? url)
    {
        var safeTitle = string.Join("-", title.Split(Path.GetInvalidFileNameChars(), StringSplitOptions.RemoveEmptyEntries)).Trim();
        if (string.IsNullOrWhiteSpace(safeTitle))
        {
            safeTitle = "fichier";
        }

        var extension = string.Empty;
        if (!string.IsNullOrWhiteSpace(url))
        {
            try
            {
                extension = Path.GetExtension(new Uri(url).AbsolutePath);
            }
            catch
            {
                extension = string.Empty;
            }
        }

        return string.IsNullOrWhiteSpace(extension) ? safeTitle : $"{safeTitle}{extension}";
    }

    private static string GetCorrectAnswerLabel(QuestionDTO question)
        => question.OptionsReponses?.FirstOrDefault(option => option.EstCorrecte)?.Texte
           ?? (question.Type == TypeQuestion.FAUX ? "Faux" : "Vrai");

    private static float NormalizeProgress(float progress)
        => Math.Clamp(progress, 0, 100);

    private static string DisplayOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetStudentName(InscriptionDTO inscription)
    {
        var fullName = $"{inscription.Edudiant?.FirstName} {inscription.Edudiant?.LastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? (inscription.Edudiant?.UserName ?? "Étudiant") : fullName;
    }

    private string GetStudentNameFromInscriptionId(int inscriptionId)
    {
        var inscription = _inscriptions.FirstOrDefault(i => i.Id == inscriptionId);
        return inscription is null ? "Étudiant" : GetStudentName(inscription);
    }

    private double GetAverageAvisNote()
        => _avis.Count == 0 ? 0 : _avis.Average(avis => avis.Note);

    private string GetAverageAvisLabel()
        => _avis.Count == 0 ? "-" : $"{GetAverageAvisNote():0.0}/{AvisMaxNote}";

    private string GetLatestAvisSummary()
    {
        var latest = _avis.OrderByDescending(avis => avis.Date).FirstOrDefault();
        if (latest is null)
        {
            return "Aucun avis récent";
        }

        return $"{GetStudentNameFromInscriptionId(latest.InscriptionId)} - {latest.Note}/{AvisMaxNote}";
    }

    private static string GetAvisStars(int note)
    {
        var normalized = Math.Clamp(note, 0, AvisMaxNote);
        return new string('★', normalized) + new string('☆', AvisMaxNote - normalized);
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response, string fallback)
    {
        var details = await response.Content.ReadAsStringAsync();
        return string.IsNullOrWhiteSpace(details) ? fallback : details;
    }
