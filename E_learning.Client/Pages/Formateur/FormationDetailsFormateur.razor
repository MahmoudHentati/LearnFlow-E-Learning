                                                                                                <MudItem xs="12" md="6">
                                                                                                    <MudSelect T="TypeQuestion" @bind-Value="_editingQuestionCorrectAnswer" Label="Bonne réponse" Variant="Variant.Outlined" FullWidth="true">
