                                                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isSavingVideoEdit" OnClick="@(() => SaveVideoAsync(video))">Enregistrer</MudButton>
                                                                                <MudButton Variant="Variant.Text" OnClick="CancelVideoEdit">Annuler</MudButton>
                                                                            </MudItem>
                                                                        </MudGrid>
                                                                    </MudPaper>
