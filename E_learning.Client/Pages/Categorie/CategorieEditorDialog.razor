@inject HttpClient Http

<MudDialog>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-3">@_errorMessage</MudAlert>
        }

        <MudTextField @bind-Value="_model.Nom" Label="Nom" Variant="Variant.Outlined" Required="true" FullWidth="true" Class="mb-3" />
        <MudTextField @bind-Value="_model.Description" Label="Description" Variant="Variant.Outlined" Lines="3" FullWidth="true" />
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="_isSaving" OnClick="Cancel">Annuler</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isSaving" OnClick="SaveAsync">
            @(_isSaving ? "Enregistrement..." : "Enregistrer")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int? CategorieId { get; set; }

    private readonly CategorieDTO _model = new();
    private string? _errorMessage;
    private bool _isSaving;
    private bool IsEdit => CategorieId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (!IsEdit)
        {
            return;
        }

        try
        {
            var loaded = await Http.GetFromJsonAsync<CategorieDTO>($"api/categories/{CategorieId.GetValueOrDefault()}");
            if (loaded is null)
            {
                _errorMessage = "Catégorie introuvable.";
                return;
            }

            _model.Id = loaded.Id;
            _model.Nom = loaded.Nom;
            _model.Description = loaded.Description;
        }
        catch
        {
            _errorMessage = "Impossible de charger la catégorie.";
        }
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Nom))
        {
            _errorMessage = "Le nom est obligatoire.";
            return;
        }

        _isSaving = true;

        try
        {
            HttpResponseMessage response = IsEdit
                ? await Http.PutAsJsonAsync($"api/categories/{_model.Id}", _model)
                : await Http.PostAsJsonAsync("api/categories", _model);

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = "L'enregistrement a échoué.";
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch
        {
            _errorMessage = "Erreur pendant l'enregistrement.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
