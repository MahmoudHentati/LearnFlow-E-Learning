                                    </div>
                                </div>
                                <div class="overview-kv">
                                    <MudText Typo="Typo.body2" Class="overview-kv-key">Moyenne</MudText>
                                    <MudText Typo="Typo.body2" Class="overview-kv-val">@GetAverageAvisNoteLabel()</MudText>
                                </div>
                                <div class="overview-kv">
                                    <MudText Typo="Typo.body2" Class="overview-kv-key">Nombre d'avis</MudText>
                                    <MudText Typo="Typo.body2" Class="overview-kv-val">@_formationAvis.Count</MudText>
                                </div>
                                <div class="overview-kv">
                                    <MudText Typo="Typo.body2" Class="overview-kv-key">Votre statut</MudText>
                                    <MudText Typo="Typo.body2" Class="overview-kv-val">@(_myAvis is null ? "Pas encore déposé" : "Avis publié")</MudText>
                                </div>
                                <div class="overview-kv mb-0">
                                    <MudText Typo="Typo.body2" Class="overview-kv-key">Dernière mise à jour</MudText>
                                    <MudText Typo="Typo.body2" Class="overview-kv-val">@(_myAvis?.Date?.ToString("yyyy-MM-dd HH:mm") ?? "-")</MudText>
                                </div>

                                @if (_formationAvis.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mt-4 content-empty-state">Aucun avis n'a encore été publié pour cette formation.</MudAlert>
                                }
                                else
                                {
                                    <div class="student-result-list mt-4">
                                        @foreach (var avis in _formationAvis.OrderByDescending(a => a.Date).Take(3))
                                        {
                                            <MudPaper Outlined="true" Elevation="0" Class="student-result-card avis-card">
                                                <div class="resource-card-head">
                                                    <div>
                                                        <MudText Typo="Typo.caption" Class="resource-eyebrow">
                                                            @(avis.InscriptionId == _inscription.Id ? "Votre avis" : "Avis d'un étudiant")
                                                        </MudText>
                                                        <MudText Typo="Typo.subtitle2" Class="resource-title">@GetAvisStars(avis.Note)</MudText>
                                                    </div>
                                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning">@($"{avis.Note}/{AvisMaxNote}")</MudChip>
                                                </div>
                                                <MudText Typo="Typo.body2" Class="mt-2">@DisplayOrDash(avis.Commentaire)</MudText>
                                                <MudText Typo="Typo.caption" Class="submitted-answer-label">Publié le @(avis.Date?.ToString("yyyy-MM-dd HH:mm") ?? "-")</MudText>
