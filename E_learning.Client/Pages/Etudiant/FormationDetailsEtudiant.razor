@page "/etudiant/formations/{Id:int}"
@using E_Learning.Models.Enums
@using E_learning.Models.Helpers
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Student")]
@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>Détail formation étudiant</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-8 mb-6 student-formation-details">
    <div class="student-hero mb-6">
        <div class="d-flex justify-space-between align-center gap-4 flex-wrap">
            <div>
                <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavigationManager.NavigateTo("/etudiant-mes-formations"))" Class="mb-2 back-btn">
                    Retour à mes formations
                </MudButton>
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h4" Style="font-weight:700;">Parcours de formation</MudText>
                </div>
                <MudText Typo="Typo.subtitle1" Class="mud-text-secondary ml-11">Suivez les contenus, passez les quiz et remettez vos tests depuis une seule page</MudText>
            </div>
            @if (_formation is not null)
            {
                <MudStack Row="true" Spacing="1" Style="flex-wrap:wrap;">
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@GetCategoryName(_formation)</MudChip>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@($"{AutomaticProgress:0}% de progression")</MudChip>
                </MudStack>
            }
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
    }
    else if (_formation is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Formation introuvable.</MudAlert>
    }
    else if (_inscription is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            Vous devez être inscrit à cette formation pour accéder aux contenus et aux évaluations.
        </MudAlert>
    }
    else
    {
        <MudGrid Class="mb-4">
            <MudItem xs="12" md="3">
                <MudPaper Outlined="true" Elevation="0" Class="pa-4 stat-card">
                    <MudText Typo="Typo.caption" Class="stat-label">Modules</MudText>
                    <MudText Typo="Typo.h5" Class="stat-value">@Modules.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Outlined="true" Elevation="0" Class="pa-4 stat-card">
                    <MudText Typo="Typo.caption" Class="stat-label">Ressources</MudText>
                    <MudText Typo="Typo.h5" Class="stat-value">@(TotalVideos + TotalDocuments)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Outlined="true" Elevation="0" Class="pa-4 stat-card">
                    <MudText Typo="Typo.caption" Class="stat-label">Quiz passés</MudText>
                    <MudText Typo="Typo.h5" Class="stat-value">@_participations.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Outlined="true" Elevation="0" Class="pa-4 stat-card">
                    <MudText Typo="Typo.caption" Class="stat-label">Tests rendus</MudText>
                    <MudText Typo="Typo.h5" Class="stat-value">@_rendus.Count</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Outlined="true" Elevation="0" Class="pa-4 mb-4 content-shell">
            <MudTabs Rounded="true" Border="true" PanelClass="tab-panel">
                <MudTabPanel Text="Aperçu">
                    <MudGrid Class="mt-2 overview-grid">
                        <MudItem xs="12" md="6">
                            <MudPaper Outlined="true" Elevation="0" Class="pa-4 info-card overview-main-card overview-highlight-card">
                                <div class="overview-section-head">
                                    <div>
                                        <MudText Typo="Typo.caption" Class="overview-label">Présentation</MudText>
                                        <MudText Typo="Typo.h5" Class="overview-heading">@DisplayOrDash(_formation.Titre)</MudText>
                                    </div>
                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@DisplayOrDash(_formation.Difficulte)</MudChip>
                                </div>
                                <div class="overview-block">
                                    <MudText Typo="Typo.caption" Class="overview-label">Description</MudText>
                                    <MudText Typo="Typo.body1" Class="overview-value">@DisplayOrDash(_formation.Description)</MudText>
                                </div>
                                <div class="overview-block mb-0">
                                    <MudText Typo="Typo.caption" Class="overview-label">Prérequis</MudText>
                                    <MudText Typo="Typo.body1" Class="overview-value">@DisplayOrDash(_formation.Prerequis)</MudText>
                                </div>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudPaper Outlined="true" Elevation="0" Class="pa-4 info-card overview-side-card">
                                <div class="overview-section-head mb-2">
                                    <div>
                                        <MudText Typo="Typo.caption" Class="overview-label">Informations</MudText>
                                        <MudText Typo="Typo.h6" Class="overview-heading">Repères de la formation</MudText>
                                    </div>
                                </div>
                                <div class="overview-kv">
                                    <MudText Typo="Typo.body2" Class="overview-kv-key">Formateur</MudText>
                                    <MudText Typo="Typo.body2" Class="overview-kv-val">@DisplayOrDash(_formation.FormateurNom)</MudText>
                                </div>
                                <div class="overview-kv">
                                    <MudText Typo="Typo.body2" Class="overview-kv-key">Difficulté</MudText>
                                    <MudText Typo="Typo.body2" Class="overview-kv-val">@DisplayOrDash(_formation.Difficulte)</MudText>
                                </div>
                                <div class="overview-kv">
                                    <MudText Typo="Typo.body2" Class="overview-kv-key">Statut</MudText>
                                    <MudText Typo="Typo.body2" Class="overview-kv-val">@FormationStatusHelper.GetDisplayLabel(_formation.Statut)</MudText>
                                </div>
                                <div class="overview-kv">
                                    <MudText Typo="Typo.body2" Class="overview-kv-key">Catégorie</MudText>
                                    <MudText Typo="Typo.body2" Class="overview-kv-val">@DisplayOrDash(_formation.SousCategorie?.Categorie?.Nom)</MudText>
                                </div>
                                <div class="overview-kv">
                                    <MudText Typo="Typo.body2" Class="overview-kv-key">Sous-catégorie</MudText>
                                    <MudText Typo="Typo.body2" Class="overview-kv-val">@DisplayOrDash(_formation.SousCategorie?.Nom)</MudText>
                                </div>
                                <div class="overview-kv mb-0">
                                    <MudText Typo="Typo.body2" Class="overview-kv-key">Date création</MudText>
                                    <MudText Typo="Typo.body2" Class="overview-kv-val">@(_formation.DateCreation?.ToString("yyyy-MM-dd") ?? "-")</MudText>
                                </div>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Modules et contenu">
                    @if (Modules.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">Aucun module disponible.</MudAlert>
                    }
                    else
                    {
                        <MudExpansionPanels MultiExpansion="true" Class="mt-3 module-panels">
                            @foreach (var module in Modules)
                            {
                                <MudExpansionPanel Text="@($"Module {module.Ordre} - {DisplayOrDash(module.Titre)}")">
                                    <MudStack Row="true" Spacing="1" Style="flex-wrap:wrap;" Class="mb-3">
                                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success">Vidéos: @(module.Videos?.Count ?? 0)</MudChip>
                                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary">Documents: @(module.Documents?.Count ?? 0)</MudChip>
                                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary">Quiz: @(module.Quizzes?.Count ?? 0)</MudChip>
                                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info">Tests: @(module.Tests?.Count ?? 0)</MudChip>
                                    </MudStack>

                                    <MudPaper Outlined="true" Elevation="0" Class="pa-3 module-tab-shell">
                                        <MudTabs Rounded="true" Border="true" PanelClass="module-tab-panel">
                                            <MudTabPanel Text="Vidéos">
                                                @if (module.Videos is null || module.Videos.Count == 0)
                                                {
                                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="content-empty-state">Aucune vidéo dans ce module.</MudAlert>
                                                }
                                                else
                                                {
                                                    <div class="resource-grid">
                                                        @foreach (var video in module.Videos.OrderBy(v => v.Ordre))
                                                        {
                                                            <MudPaper Outlined="true" Elevation="0" Class="resource-card resource-card-video">
                                                                <div class="resource-card-head">
                                                                    <div>
                                                                        <MudText Typo="Typo.caption" Class="resource-eyebrow">Vidéo #@video.Ordre</MudText>
                                                                        <MudText Typo="Typo.subtitle1" Class="resource-title">@DisplayOrDash(video.Titre)</MudText>
                                                                    </div>
                                                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Success">@($"{Math.Max(0, video.Duree)} min")</MudChip>
                                                                </div>
                                                                @if (!string.IsNullOrWhiteSpace(video.UrlVideo))
                                                                {
                                                                    <video class="student-media-preview" controls preload="metadata">
                                                                        <source src="@video.UrlVideo" />
                                                                    </video>
                                                                }
                                                                <div class="resource-actions">
                                                                    <a class="resource-action-link" href="@video.UrlVideo" target="_blank" rel="noopener noreferrer">Ouvrir</a>
                                                                    <a class="resource-action-link secondary" href="@video.UrlVideo" target="_blank" rel="noopener noreferrer" download="@GetDownloadFileName(video.Titre, video.UrlVideo)">Télécharger</a>
                                                                </div>
                                                            </MudPaper>
                                                        }
                                                    </div>
                                                }
                                            </MudTabPanel>

                                            <MudTabPanel Text="Documents">
                                                @if (module.Documents is null || module.Documents.Count == 0)
                                                {
                                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="content-empty-state">Aucun document dans ce module.</MudAlert>
                                                }
                                                else
                                                {
                                                    <div class="resource-grid">
                                                        @foreach (var doc in module.Documents.OrderBy(d => d.Ordre))
                                                        {
                                                            <MudPaper Outlined="true" Elevation="0" Class="resource-card resource-card-document">
                                                                <div class="resource-card-head">
                                                                    <div>
                                                                        <MudText Typo="Typo.caption" Class="resource-eyebrow">Document #@doc.Ordre</MudText>
                                                                        <MudText Typo="Typo.subtitle1" Class="resource-title">@DisplayOrDash(doc.Titre)</MudText>
                                                                    </div>
                                                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">@GetDocumentFormatLabel(doc)</MudChip>
                                                                </div>
                                                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Ressource pédagogique téléchargeable ou consultable dans un nouvel onglet.</MudText>
                                                                <div class="resource-actions">
                                                                    <a class="resource-action-link" href="@doc.UrlFichier" target="_blank" rel="noopener noreferrer">Ouvrir</a>
                                                                    <a class="resource-action-link secondary" href="@doc.UrlFichier" target="_blank" rel="noopener noreferrer" download="@GetDownloadFileName(doc.Titre, doc.UrlFichier)">Télécharger</a>
                                                                </div>
                                                            </MudPaper>
                                                        }
                                                    </div>
                                                }
                                            </MudTabPanel>

                                            <MudTabPanel Text="Quiz">
                                                @if (module.Quizzes is null || module.Quizzes.Count == 0)
                                                {
                                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="content-empty-state">Aucun quiz dans ce module.</MudAlert>
                                                }
                                                else
                                                {
                                                    <MudExpansionPanels MultiExpansion="true" Class="quiz-panels">
                                                        @foreach (var quiz in module.Quizzes.OrderBy(q => q.Id))
                                                        {
                                                            var participation = GetParticipation(quiz.Id);
                                                            var questionCount = quiz.Questions?.Count ?? 0;
                                                            var maxScore = GetQuizMaximumScore(quiz);
                                                            var isQuizLocked = participation is not null;
                                                            <MudExpansionPanel Class="quiz-panel-item" Text="@GetQuizPanelTitle(quiz, module, participation, maxScore)">
                                                                <MudPaper Outlined="true" Elevation="0" Class="evaluation-card quiz-card">
                                                                <div class="resource-card-head quiz-card-head">
                                                                    <div>
                                                                        <MudText Typo="Typo.caption" Class="resource-eyebrow">Quiz #@quiz.Id</MudText>
                                                                        <MudText Typo="Typo.subtitle1" Class="resource-title">@GetQuizTitle(quiz, module)</MudText>
                                                                    </div>
                                                                    <MudChip T="string" Variant="Variant.Outlined" Color="@(participation is null ? Color.Warning : GetQuizParticipationColor(participation, quiz))">
                                                                        @(participation is null ? "Non passé" : $"{participation.Score}/{maxScore}")
                                                                    </MudChip>
                                                                </div>

                                                                <div class="resource-meta-row">
                                                                    <MudText Typo="Typo.body2">Questions: @questionCount</MudText>
                                                                    <MudText Typo="Typo.body2">Score minimum: @quiz.ScoreMinimum</MudText>
                                                                    <MudText Typo="Typo.body2">Durée limite: @quiz.DLimite min</MudText>
                                                                </div>

                                                                @if (participation is not null)
                                                                {
                                                                    <MudAlert Severity="@(participation.Score >= quiz.ScoreMinimum ? Severity.Success : Severity.Warning)" Variant="Variant.Outlined" Class="mb-3">
                                                                        Dernier passage le @(participation.DatePassage?.ToString("yyyy-MM-dd HH:mm") ?? "-") avec un score de @participation.Score / @maxScore.
                                                                    </MudAlert>
                                                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mb-3">
                                                                        Ce quiz est verrouillé après validation. Les réponses ne peuvent plus être modifiées.
                                                                    </MudAlert>
                                                                }

                                                                @if (questionCount == 0)
                                                                {
                                                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text">Ce quiz ne contient pas encore de questions.</MudAlert>
                                                                }
                                                                else
                                                                {
                                                                    <div class="question-list">
                                                                        @foreach (var question in quiz.Questions.OrderBy(q => q.Id))
                                                                        {
                                                                            <MudPaper Outlined="true" Elevation="0" Class="question-card">
                                                                                <MudText Typo="Typo.subtitle2" Class="mb-1">@question.Enonce</MudText>
                                                                                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">Barème: @question.Bareme point(s)</MudText>
                                                                                <MudRadioGroup T="string" Value="GetQuizAnswer(quiz.Id, question.Id)" ValueChanged="value => SetQuizAnswer(quiz.Id, question.Id, value)" Disabled="@isQuizLocked">
                                                                                    <MudRadio T="string" Value="@("VRAI")" Color="Color.Success" Disabled="@isQuizLocked">Vrai</MudRadio>
                                                                                    <MudRadio T="string" Value="@("FAUX")" Color="Color.Error" Disabled="@isQuizLocked">Faux</MudRadio>
                                                                                </MudRadioGroup>
                                                                                @if (isQuizLocked)
                                                                                {
                                                                                    <MudText Typo="Typo.caption" Class="submitted-answer-label">
                                                                                        @GetSubmittedQuizAnswerLabel(quiz.Id, question.Id)
                                                                                    </MudText>
                                                                                }
                                                                            </MudPaper>
                                                                        }
                                                                    </div>
                                                                }

                                                                @if (TryGetQuizError(quiz.Id, out var quizError))
                                                                {
                                                                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-3">@quizError</MudAlert>
                                                                }

                                                                @if (TryGetQuizSuccess(quiz.Id, out var quizSuccess))
                                                                {
                                                                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-3">@quizSuccess</MudAlert>
                                                                }

                                                                @if (!isQuizLocked)
                                                                {
                                                                    <div class="resource-actions mt-3">
                                                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_quizSubmittingIds.Contains(quiz.Id) || !CanSubmitQuiz(quiz))" OnClick="@(() => SubmitQuizAsync(quiz))">
                                                                            @(_quizSubmittingIds.Contains(quiz.Id) ? "Envoi..." : "Passer le quiz")
                                                                        </MudButton>
                                                                        <MudButton Variant="Variant.Text" Disabled="_quizSubmittingIds.Contains(quiz.Id)" OnClick="@(() => ResetQuizAnswers(quiz.Id))">
                                                                            Réinitialiser
                                                                        </MudButton>
                                                                    </div>
                                                                }
                                                            </MudPaper>
                                                            </MudExpansionPanel>
                                                        }
                                                    </MudExpansionPanels>
                                                }
                                            </MudTabPanel>

                                            <MudTabPanel Text="Tests">
                                                @if (module.Tests is null || module.Tests.Count == 0)
                                                {
                                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="content-empty-state">Aucun test dans ce module.</MudAlert>
                                                }
                                                else
                                                {
                                                    <div class="evaluation-grid">
                                                        @foreach (var test in module.Tests.OrderBy(t => t.Id))
                                                        {
                                                            var rendu = GetRendu(test.Id);
                                                            <MudPaper Outlined="true" Elevation="0" Class="evaluation-card test-card">
                                                                <div class="resource-card-head">
                                                                    <div>
                                                                        <MudText Typo="Typo.caption" Class="resource-eyebrow">Test #@test.Id</MudText>
                                                                        <MudText Typo="Typo.subtitle1" Class="resource-title">@DisplayOrDash(test.Consigne)</MudText>
                                                                    </div>
                                                                    <MudChip T="string" Variant="Variant.Outlined" Color="@(rendu is null ? Color.Warning : Color.Success)">
                                                                        @(rendu is null ? "À remettre" : "Rendu envoyé")
                                                                    </MudChip>
                                                                </div>

                                                                <div class="resource-actions mb-3">
                                                                    @if (!string.IsNullOrWhiteSpace(test.FichierConsigneUrl))
                                                                    {
                                                                        <a class="resource-action-link" href="@test.FichierConsigneUrl" target="_blank" rel="noopener noreferrer">Ouvrir la consigne</a>
                                                                        <a class="resource-action-link secondary" href="@test.FichierConsigneUrl" target="_blank" rel="noopener noreferrer" download="@GetDownloadFileName($"consigne-test-{test.Id}", test.FichierConsigneUrl)">Télécharger</a>
                                                                    }
                                                                </div>

                                                                @if (rendu is not null)
                                                                {
                                                                    <MudPaper Outlined="true" Elevation="0" Class="submitted-work-box mb-3 pa-3">
                                                                        <div class="resource-meta-row">
                                                                            <MudText Typo="Typo.body2">Soumis le: @(rendu.DateSoumission?.ToString("yyyy-MM-dd HH:mm") ?? "-")</MudText>
                                                                            <MudText Typo="Typo.body2">Note: @(rendu.Note.HasValue ? $"{rendu.Note}/20" : "En attente")</MudText>
                                                                        </div>
                                                                        @if (!string.IsNullOrWhiteSpace(rendu.CommentaireFormateur))
                                                                        {
                                                                            <MudText Typo="Typo.body2" Class="mt-2">Retour formateur: @rendu.CommentaireFormateur</MudText>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(rendu.FichierUrl))
                                                                        {
                                                                            <div class="resource-actions mt-2">
                                                                                <a class="resource-action-link" href="@rendu.FichierUrl" target="_blank" rel="noopener noreferrer">Ouvrir mon rendu</a>
                                                                                <a class="resource-action-link secondary" href="@rendu.FichierUrl" target="_blank" rel="noopener noreferrer" download="@GetDownloadFileName($"rendu-{test.Id}", rendu.FichierUrl)">Télécharger mon rendu</a>
                                                                            </div>
                                                                        }
                                                                    </MudPaper>
                                                                }

                                                                <MudTextField T="string" Value="GetTestDraftContent(test.Id)" ValueChanged="value => SetTestDraftContent(test.Id, value)" Label="Message ou réponse" Variant="Variant.Outlined" Lines="4" FullWidth="true" Class="mb-3" Disabled="@(rendu is not null)" />

                                                                @if (rendu is null)
                                                                {
                                                                    <div class="test-upload-box mb-3">
                                                                        <label class="test-upload-label" for="@($"student-test-file-{test.Id}")">Choisir un fichier</label>
                                                                        <InputFile id="@($"student-test-file-{test.Id}")" OnChange="args => OnStudentTestFileSelected(test.Id, args)" class="test-upload-input" accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.zip,.rar,image/*" />
                                                                        <div class="test-upload-help">
                                                                            @if (string.IsNullOrWhiteSpace(GetStudentTestFileName(test.Id)))
                                                                            {
                                                                                <span>Aucun fichier sélectionné.</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span>Fichier sélectionné : @GetStudentTestFileName(test.Id)</span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mb-3">
                                                                        Ce test a déjà été envoyé. Le contenu et le fichier ne peuvent plus être modifiés.
                                                                    </MudAlert>
                                                                }

                                                                @if (TryGetTestError(test.Id, out var testError))
                                                                {
                                                                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-3">@testError</MudAlert>
                                                                }

                                                                @if (TryGetTestSuccess(test.Id, out var testSuccess))
                                                                {
                                                                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-3">@testSuccess</MudAlert>
                                                                }

                                                                @if (rendu is null)
                                                                {
                                                                    <div class="resource-actions">
                                                                        <MudButton Variant="Variant.Filled" Color="Color.Info" Disabled="_testSubmittingIds.Contains(test.Id)" OnClick="@(() => SubmitTestAsync(test))">
                                                                            @(_testSubmittingIds.Contains(test.Id) ? "Envoi..." : "Envoyer mon test")
                                                                        </MudButton>
                                                                        <MudButton Variant="Variant.Text" Disabled="_testSubmittingIds.Contains(test.Id)" OnClick="@(() => ResetTestDraft(test.Id, preserveExistingContent: true))">
                                                                            Réinitialiser le brouillon
                                                                        </MudButton>
                                                                    </div>
                                                                }
                                                            </MudPaper>
                                                        }
                                                    </div>
                                                }
                                            </MudTabPanel>
                                        </MudTabs>
                                    </MudPaper>
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Mon suivi">
                    <MudGrid Class="mt-2">
                        <MudItem xs="12" md="4">
                            <MudPaper Outlined="true" Elevation="0" Class="pa-3 stat-card compact-stat">
                                <MudText Typo="Typo.caption" Class="stat-label">Progression automatique</MudText>
                                <MudText Typo="Typo.h6" Class="stat-value">@($"{AutomaticProgress:0}%")</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudPaper Outlined="true" Elevation="0" Class="pa-3 stat-card compact-stat">
                                <MudText Typo="Typo.caption" Class="stat-label">Quiz validés</MudText>
                                <MudText Typo="Typo.h6" Class="stat-value">@GetValidatedQuizCount()</MudText>
                            </MudPaper>
                        </MudItem>
