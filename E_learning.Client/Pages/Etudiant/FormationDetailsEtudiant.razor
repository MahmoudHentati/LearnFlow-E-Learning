        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private FormationDTO? _formation;
    private InscriptionDTO? _inscription;
    private List<ParticipationQuizDTO> _participations = [];
    private List<RenduTestDTO> _rendus = [];
    private List<AvisDTO> _formationAvis = [];
    private AvisDTO? _myAvis;
    private readonly Dictionary<int, Dictionary<int, string>> _quizAnswers = [];
    private readonly HashSet<int> _quizSubmittingIds = [];
    private readonly Dictionary<int, string> _quizErrorMessages = [];
    private readonly Dictionary<int, string> _quizSuccessMessages = [];
    private readonly Dictionary<int, string> _testDraftContents = [];
    private readonly Dictionary<int, IBrowserFile?> _testDraftFiles = [];
    private readonly Dictionary<int, string> _testDraftFileNames = [];
    private readonly HashSet<int> _testSubmittingIds = [];
    private readonly Dictionary<int, string> _testErrorMessages = [];
    private readonly Dictionary<int, string> _testSuccessMessages = [];
    private int _avisDraftNote = 5;
    private string _avisDraftCommentaire = string.Empty;
    private bool _avisSubmitting;
    private string? _avisErrorMessage;
    private string? _avisSuccessMessage;
    private bool _isLoading = true;
    private string? _errorMessage;

    private const long MaxStudentUploadFileSize = 25 * 1024 * 1024;
    private const int AvisMaxNote = 6;

    private List<ModuleDTO> Modules => _formation?.Modules?.OrderBy(m => m.Ordre).ToList() ?? [];
    private int TotalVideos => Modules.Sum(m => m.Videos?.Count ?? 0);
    private int TotalDocuments => Modules.Sum(m => m.Documents?.Count ?? 0);
    private float AutomaticProgress => CalculateAutomaticProgress();

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _formation = await Http.GetFromJsonAsync<FormationDTO>($"api/formation/{Id}");
            if (_formation is null)
            {
                return;
            }

            await EnsureQuizQuestionsLoadedAsync(_formation);

            var inscriptions = await Http.GetFromJsonAsync<List<InscriptionDTO>>("api/inscriptions/me") ?? [];
            _inscription = inscriptions.FirstOrDefault(i => i.FormationId == Id);

            if (_inscription is not null)
            {
                _participations = await Http.GetFromJsonAsync<List<ParticipationQuizDTO>>($"api/participationquizzes/inscription/{_inscription.Id}") ?? [];
                _rendus = await Http.GetFromJsonAsync<List<RenduTestDTO>>($"api/rendutests/inscription/{_inscription.Id}") ?? [];
                await LoadAvisAsync();
                HydrateLinkedEntities();
                InitializeTestDrafts();
                await SyncAutomaticProgressAsync();
            }
        }
        catch
        {
            _errorMessage = "Impossible de charger les détails de la formation.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task EnsureQuizQuestionsLoadedAsync(FormationDTO formation)
    {
        foreach (var module in formation.Modules ?? [])
        {
            foreach (var quiz in module.Quizzes ?? [])
            {
                if (quiz.Questions is null || quiz.Questions.Count == 0)
                {
                    quiz.Questions = await Http.GetFromJsonAsync<List<QuestionDTO>>($"api/questions/quiz/{quiz.Id}") ?? [];
                }
            }
        }
    }

    private void HydrateLinkedEntities()
    {
        foreach (var participation in _participations)
        {
            participation.Quiz = FindQuiz(participation.QuizId);
        }

        foreach (var rendu in _rendus)
        {
            rendu.Test = FindTest(rendu.TestId);
        }
    }

    private void InitializeTestDrafts()
    {
        foreach (var rendu in _rendus)
        {
            _testDraftContents[rendu.TestId] = rendu.Contenu ?? string.Empty;
        }
    }

    private async Task LoadAvisAsync()
    {
        if (_inscription is null)
        {
            _formationAvis = [];
            _myAvis = null;
            return;
        }

        _formationAvis = await Http.GetFromJsonAsync<List<AvisDTO>>($"api/avis/formation/{Id}") ?? [];
        _myAvis = _formationAvis
            .Where(avis => avis.InscriptionId == _inscription.Id)
            .OrderByDescending(avis => avis.Date)
            .ThenByDescending(avis => avis.Id)
            .FirstOrDefault();

        InitializeAvisDraft();
    }

    private void InitializeAvisDraft()
    {
        _avisDraftNote = _myAvis?.Note is >= 1 and <= AvisMaxNote ? _myAvis.Note : AvisMaxNote - 1;
        _avisDraftCommentaire = _myAvis?.Commentaire ?? string.Empty;
    }

    private async Task SubmitAvisAsync()
    {
        if (_inscription is null)
        {
            return;
        }

        _avisErrorMessage = null;
        _avisSuccessMessage = null;

        if (_avisDraftNote is < 1 or > AvisMaxNote)
        {
            _avisErrorMessage = $"Veuillez choisir une note entre 1 et {AvisMaxNote}.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_avisDraftCommentaire))
        {
            _avisErrorMessage = "Veuillez saisir un commentaire avant de publier votre avis.";
            return;
        }

        _avisSubmitting = true;

        try
        {
            var hadExistingAvis = _myAvis is not null;
            var payload = new AvisDTO
            {
                Id = _myAvis?.Id ?? 0,
                Note = _avisDraftNote,
                Commentaire = _avisDraftCommentaire.Trim(),
                Date = DateTime.UtcNow,
                InscriptionId = _inscription.Id
            };

            HttpResponseMessage response;
            if (_myAvis is null)
            {
                response = await Http.PostAsJsonAsync("api/avis", payload);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/avis/{_myAvis.Id}", payload);
            }

            if (!response.IsSuccessStatusCode)
            {
                _avisErrorMessage = await ReadErrorAsync(response, "Impossible d'enregistrer votre avis.");
                return;
            }

            await LoadAvisAsync();
            _avisSuccessMessage = hadExistingAvis
                ? "Votre avis a été mis à jour avec succès."
                : "Votre avis a été publié avec succès.";
        }
        catch
        {
            _avisErrorMessage = "Une erreur est survenue pendant l'enregistrement de votre avis.";
        }
        finally
        {
            _avisSubmitting = false;
        }
    }

    private async Task SubmitQuizAsync(QuizDTO quiz)
    {
        if (_inscription is null)
        {
            return;
        }

        _quizErrorMessages.Remove(quiz.Id);
        _quizSuccessMessages.Remove(quiz.Id);

        if (!CanSubmitQuiz(quiz))
        {
            _quizErrorMessages[quiz.Id] = "Répondez à toutes les questions avant d'envoyer le quiz.";
            return;
        }

        _quizSubmittingIds.Add(quiz.Id);

        try
        {
            var score = CalculateQuizScore(quiz);
            var existing = GetParticipation(quiz.Id);
            var payload = new ParticipationQuizDTO
            {
                Id = existing?.Id ?? 0,
                DatePassage = DateTime.UtcNow,
                Score = score,
                QuizId = quiz.Id,
                InscriptionId = _inscription.Id
            };

            HttpResponseMessage response;
            if (existing is null)
            {
                response = await Http.PostAsJsonAsync("api/participationquizzes", payload);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/participationquizzes/{existing.Id}", payload);
            }

            if (!response.IsSuccessStatusCode)
            {
                _quizErrorMessages[quiz.Id] = await ReadErrorAsync(response, "Impossible d'enregistrer votre quiz.");
                return;
            }

            if (existing is null)
            {
                var created = await response.Content.ReadFromJsonAsync<ParticipationQuizDTO>();
                if (created is null)
                {
                    _quizErrorMessages[quiz.Id] = "La participation n'a pas pu être rechargée.";
                    return;
                }

                created.Quiz = quiz;
                _participations.Add(created);
            }
            else
            {
                existing.Score = score;
                existing.DatePassage = payload.DatePassage;
                existing.Quiz = quiz;
            }

            await SyncAutomaticProgressAsync();
            _quizSuccessMessages[quiz.Id] = score >= quiz.ScoreMinimum
                ? "Quiz validé avec succès."
                : "Quiz envoyé. Vous pouvez le repasser pour améliorer votre score.";
        }
        catch
        {
            _quizErrorMessages[quiz.Id] = "Une erreur est survenue pendant l'envoi du quiz.";
        }
        finally
        {
            _quizSubmittingIds.Remove(quiz.Id);
        }
    }

    private async Task SubmitTestAsync(TestDTO test)
    {
        if (_inscription is null)
        {
            return;
        }

        _testErrorMessages.Remove(test.Id);
        _testSuccessMessages.Remove(test.Id);

        var draftContent = GetTestDraftContent(test.Id).Trim();
        var draftFile = GetStudentTestFile(test.Id);

        if (string.IsNullOrWhiteSpace(draftContent) && draftFile is null)
        {
            _testErrorMessages[test.Id] = "Ajoutez un message ou sélectionnez un fichier avant l'envoi.";
            return;
        }

        _testSubmittingIds.Add(test.Id);

        try
        {
            using var formData = new MultipartFormDataContent
            {
                { new StringContent(draftContent), "Contenu" },
                { new StringContent(test.Id.ToString()), "TestId" },
                { new StringContent(_inscription.Id.ToString()), "InscriptionId" }
            };

            if (draftFile is not null)
            {
                var fileStream = draftFile.OpenReadStream(MaxStudentUploadFileSize);
                var streamContent = new StreamContent(fileStream);
                if (!string.IsNullOrWhiteSpace(draftFile.ContentType))
                {
                    streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(draftFile.ContentType);
                }

                formData.Add(streamContent, "Fichier", draftFile.Name);
            }

            var response = await Http.PostAsync("api/rendutests/upload", formData);
            if (!response.IsSuccessStatusCode)
            {
                _testErrorMessages[test.Id] = await ReadErrorAsync(response, "Impossible d'envoyer le test.");
                return;
            }

            var saved = await response.Content.ReadFromJsonAsync<RenduTestDTO>();
            if (saved is null)
            {
                _testErrorMessages[test.Id] = "Le rendu n'a pas pu être rechargé.";
                return;
            }

            saved.Test = test;
            var existing = GetRendu(test.Id);
            if (existing is null)
            {
                _rendus.Add(saved);
            }
            else
            {
                existing.Id = saved.Id;
                existing.DateSoumission = saved.DateSoumission;
                existing.Contenu = saved.Contenu;
                existing.FichierUrl = saved.FichierUrl;
                existing.Note = saved.Note;
                existing.CommentaireFormateur = saved.CommentaireFormateur;
                existing.Test = test;
            }

            _testDraftContents[test.Id] = saved.Contenu ?? string.Empty;
            _testDraftFiles.Remove(test.Id);
            _testDraftFileNames.Remove(test.Id);
            await SyncAutomaticProgressAsync();
            _testSuccessMessages[test.Id] = "Votre rendu a bien été enregistré.";
        }
        catch
        {
            _testErrorMessages[test.Id] = "Une erreur est survenue pendant l'envoi du test.";
        }
        finally
        {
            _testSubmittingIds.Remove(test.Id);
        }
    }

    private async Task SyncAutomaticProgressAsync()
    {
        if (_inscription is null)
        {
            return;
        }

        var automaticProgress = CalculateAutomaticProgress();
        if (Math.Abs(_inscription.Progression - automaticProgress) < 0.01f)
        {
            return;
        }

        _inscription.Progression = automaticProgress;
        var dto = new InscriptionDTO
        {
            Id = _inscription.Id,
            DateInscription = _inscription.DateInscription,
            Progression = automaticProgress,
            EdudiantId = _inscription.EdudiantId,
            FormationId = _inscription.FormationId
        };

        await Http.PutAsJsonAsync($"api/inscriptions/{_inscription.Id}", dto);
    }

    private bool CanSubmitQuiz(QuizDTO quiz)
        => quiz.Questions is not null
           && quiz.Questions.Count > 0
           && quiz.Questions.All(question => !string.IsNullOrWhiteSpace(GetQuizAnswer(quiz.Id, question.Id)));

    private float CalculateQuizScore(QuizDTO quiz)
    {
        var score = 0f;
        foreach (var question in quiz.Questions ?? [])
        {
            var selectedAnswer = GetQuizAnswer(quiz.Id, question.Id);
            if (string.IsNullOrWhiteSpace(selectedAnswer))
            {
                continue;
            }

            var selectedIsTrue = string.Equals(selectedAnswer, "VRAI", StringComparison.OrdinalIgnoreCase);
            if (IsCorrectAnswer(question, selectedIsTrue))
            {
                score += question.Bareme;
            }
        }

        return score;
    }

    private static bool IsCorrectAnswer(QuestionDTO question, bool selectedIsTrue)
    {
        var correctOption = question.OptionsReponses?.FirstOrDefault(option => option.EstCorrecte);
        if (correctOption is not null)
        {
            return string.Equals(correctOption.Texte?.Trim(), selectedIsTrue ? "VRAI" : "FAUX", StringComparison.OrdinalIgnoreCase);
        }

        return question.Type == TypeQuestion.VRAI ? selectedIsTrue : !selectedIsTrue;
    }

    private string GetQuizAnswer(int quizId, int questionId)
    {
        if (_quizAnswers.TryGetValue(quizId, out var answers)
            && answers.TryGetValue(questionId, out var answer))
        {
            return answer;
        }

        return string.Empty;
    }

    private void SetQuizAnswer(int quizId, int questionId, string? value)
    {
        if (!_quizAnswers.TryGetValue(quizId, out var answers))
        {
            answers = [];
            _quizAnswers[quizId] = answers;
        }

        answers[questionId] = value ?? string.Empty;
    }

    private void ResetQuizAnswers(int quizId)
    {
        _quizAnswers.Remove(quizId);
        _quizErrorMessages.Remove(quizId);
        _quizSuccessMessages.Remove(quizId);
    }

    private void OnStudentTestFileSelected(int testId, InputFileChangeEventArgs eventArgs)
    {
        _testDraftFiles[testId] = eventArgs.File;
        _testDraftFileNames[testId] = eventArgs.File.Name;
        _testErrorMessages.Remove(testId);
        _testSuccessMessages.Remove(testId);
    }

    private string GetStudentTestFileName(int testId)
        => _testDraftFileNames.TryGetValue(testId, out var fileName) ? fileName : string.Empty;

    private IBrowserFile? GetStudentTestFile(int testId)
        => _testDraftFiles.TryGetValue(testId, out var file) ? file : null;

    private string GetTestDraftContent(int testId)
        => _testDraftContents.TryGetValue(testId, out var content) ? content : string.Empty;

    private void SetTestDraftContent(int testId, string? value)
    {
        _testDraftContents[testId] = value ?? string.Empty;
        _testErrorMessages.Remove(testId);
        _testSuccessMessages.Remove(testId);
    }

    private void ResetTestDraft(int testId, bool preserveExistingContent)
    {
        if (preserveExistingContent)
        {
            var existing = GetRendu(testId);
            _testDraftContents[testId] = existing?.Contenu ?? string.Empty;
        }
        else
        {
            _testDraftContents.Remove(testId);
        }

        _testDraftFiles.Remove(testId);
        _testDraftFileNames.Remove(testId);
        _testErrorMessages.Remove(testId);
        _testSuccessMessages.Remove(testId);
    }

    private ParticipationQuizDTO? GetParticipation(int quizId)
        => _participations.FirstOrDefault(participation => participation.QuizId == quizId);

    private RenduTestDTO? GetRendu(int testId)
        => _rendus.FirstOrDefault(rendu => rendu.TestId == testId);

    private ModuleDTO? FindModule(int quizId)
        => Modules.FirstOrDefault(module => module.Quizzes?.Any(quiz => quiz.Id == quizId) == true);

    private QuizDTO? FindQuiz(int quizId)
        => Modules.SelectMany(module => module.Quizzes ?? []).FirstOrDefault(quiz => quiz.Id == quizId);

    private TestDTO? FindTest(int testId)
        => Modules.SelectMany(module => module.Tests ?? []).FirstOrDefault(test => test.Id == testId);

    private int GetValidatedQuizCount()
        => _participations.Count(participation =>
            participation.Quiz is not null && participation.Score >= participation.Quiz.ScoreMinimum);

    private float CalculateAutomaticProgress()
    {
        var totalQuizzes = Modules.Sum(module => module.Quizzes?.Count ?? 0);
        var totalTests = Modules.Sum(module => module.Tests?.Count ?? 0);
        var totalEvaluations = totalQuizzes + totalTests;

        if (totalEvaluations <= 0)
        {
            return 0;
        }

        var completedQuizzes = _participations.Select(participation => participation.QuizId).Distinct().Count();
        var completedTests = _rendus.Select(rendu => rendu.TestId).Distinct().Count();
        var progress = (float)(completedQuizzes + completedTests) / totalEvaluations * 100f;
        return Math.Clamp(progress, 0, 100);
    }

    private static string DisplayOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetCategoryName(FormationDTO formation)
        => formation.SousCategorie?.Categorie?.Nom
           ?? formation.SousCategorie?.Nom
           ?? "Sans catégorie";

    private static string GetQuizTitle(QuizDTO? quiz, ModuleDTO? module)
        => quiz is null
            ? "Quiz"
            : $"{DisplayOrDash(module?.Titre)} - {quiz.Questions?.Count ?? 0} question(s)";

    private static string GetQuizPanelTitle(QuizDTO quiz, ModuleDTO module, ParticipationQuizDTO? participation, float maxScore)
        => participation is null
            ? $"{DisplayOrDash(module.Titre)} - Quiz #{quiz.Id}"
            : $"{DisplayOrDash(module.Titre)} - Quiz #{quiz.Id} - {participation.Score}/{maxScore}";

    private static float GetQuizMaximumScore(QuizDTO? quiz)
        => quiz?.Questions?.Sum(question => question.Bareme) ?? 0f;

    private static Color GetQuizParticipationColor(ParticipationQuizDTO participation, QuizDTO? quiz)
        => participation.Score >= (quiz?.ScoreMinimum ?? 0) ? Color.Success : Color.Warning;

    private static Color GetRenduNoteColor(float? note)
        => note is null ? Color.Warning : note >= 10 ? Color.Success : Color.Error;

    private static string FormatRenduNote(float? note)
        => note.HasValue ? $"{note}/20" : "En attente";

    private static string GetDownloadFileName(string? baseName, string? url)
    {
        var extension = Path.GetExtension(url ?? string.Empty);
        var safeBase = string.IsNullOrWhiteSpace(baseName) ? "fichier" : baseName.Trim();
        return string.IsNullOrWhiteSpace(extension) ? safeBase : $"{safeBase}{extension}";
    }

    private static string GetDocumentFormatLabel(DocumentDTO document)
    {
        if (!string.IsNullOrWhiteSpace(document.Format))
        {
            return document.Format.ToUpperInvariant();
        }

        var extension = Path.GetExtension(document.UrlFichier ?? string.Empty);
        return string.IsNullOrWhiteSpace(extension) ? "DOC" : extension.Trim('.').ToUpperInvariant();
    }

    private double GetAverageAvisNote()
        => _formationAvis.Count == 0 ? 0 : _formationAvis.Average(avis => avis.Note);

    private string GetAverageAvisNoteLabel()
        => _formationAvis.Count == 0 ? "-" : $"{GetAverageAvisNote():0.0}/{AvisMaxNote}";

    private static string GetAvisStars(int note)
    {
        var normalized = Math.Clamp(note, 0, AvisMaxNote);
        return new string('★', normalized) + new string('☆', AvisMaxNote - normalized);
    }

    private string GetSubmittedQuizAnswerLabel(int quizId, int questionId)
    {
        var answer = GetQuizAnswer(quizId, questionId);
        return string.IsNullOrWhiteSpace(answer)
            ? "Réponse envoyée, détail non disponible après rechargement."
            : $"Réponse envoyée : {answer}";
    }

    private bool TryGetQuizError(int quizId, out string message)
        => _quizErrorMessages.TryGetValue(quizId, out message!);

    private bool TryGetQuizSuccess(int quizId, out string message)
        => _quizSuccessMessages.TryGetValue(quizId, out message!);

    private bool TryGetTestError(int testId, out string message)
        => _testErrorMessages.TryGetValue(testId, out message!);

    private bool TryGetTestSuccess(int testId, out string message)
        => _testSuccessMessages.TryGetValue(testId, out message!);

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response, string fallbackMessage)
    {
        try
        {
            var error = await response.Content.ReadAsStringAsync();
            return string.IsNullOrWhiteSpace(error) ? fallbackMessage : error;
        }
        catch
        {
            return fallbackMessage;
        }
    }
}
