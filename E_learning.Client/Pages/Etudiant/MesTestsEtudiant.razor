@page "/etudiant-mes-tests"
@attribute [Authorize(Roles = "Student")]
@inject HttpClient Http

<PageTitle>Mes tests</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Style="font-weight:700; color:#1E3A8A;">Mes Tests</MudText>
            </div>
            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary ml-11">Tous vos tests avec formation, module et état du rendu</MudText>
        </div>
        <div class="d-flex align-center gap-4">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small" Class="font-weight-bold">
                @_testItems.Count tests
            </MudChip>
            <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Class="font-weight-bold">
                @_testItems.Count(item => item.Rendu is not null) remis
            </MudChip>
        </div>
    </div>

    <MudPaper Elevation="0" Outlined="true" Square="false" Style="border-radius:4px;" Class="pa-4 mb-4">
        <div class="d-flex justify-space-between align-center mb-4">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
                <MudText Typo="Typo.button">CRITÈRES DE RECHERCHE</MudText>
            </div>
            @if (!string.IsNullOrWhiteSpace(_searchText))
            {
                <MudButton StartIcon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" OnClick="@(() => _searchText = string.Empty)" Color="Color.Secondary">
                    RÉINITIALISER
                </MudButton>
            }
        </div>
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_searchText" Placeholder="Rechercher formation, module ou test..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Style="border-radius:4px;" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_statusFilter" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@AllStatus">Tous les statuts</MudSelectItem>
                    <MudSelectItem T="string" Value="@DoneStatus">Remis</MudSelectItem>
                    <MudSelectItem T="string" Value="@PendingStatus">Non remis</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_isLoading)
    {
        <MudPaper Elevation="0" Outlined="true" Square="false" Style="border-radius:4px;">
            <div class="d-flex justify-center pa-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            </div>
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Square="false" Style="border-radius:4px;">
            <MudTable Items="@FilteredTestItems" Dense="true" Hover="true" Striped="true" Bordered="false">
                <HeaderContent>
                    <MudTh>Formation</MudTh>
                    <MudTh>Module</MudTh>
                    <MudTh>Test</MudTh>
                    <MudTh>Statut</MudTh>
                    <MudTh>Note</MudTh>
                    <MudTh>Soumis le</MudTh>
                    <MudTh>Consigne</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd DataLabel="Formation">@item.FormationTitle</MudTd>
                    <MudTd DataLabel="Module">@item.ModuleTitle</MudTd>
                    <MudTd DataLabel="Test">@DisplayOrDash(item.Test.Consigne)</MudTd>
                    <MudTd DataLabel="Statut">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(item.Rendu is null ? Color.Warning : Color.Success)">
                            @(item.Rendu is null ? "Non remis" : "Remis")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Note">@FormatNote(item.Rendu?.Note)</MudTd>
                    <MudTd DataLabel="Soumis le">@(item.Rendu?.DateSoumission?.ToString("yyyy-MM-dd HH:mm") ?? "-")</MudTd>
                    <MudTd DataLabel="Consigne">
                        @if (!string.IsNullOrWhiteSpace(item.Test.FichierConsigneUrl))
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Info" Href="@item.Test.FichierConsigneUrl" Target="_blank">
                                Ouvrir
                            </MudButton>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/etudiant/formations/{item.FormationId}")">
                            Ouvrir
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager RowsPerPageString="Lignes par page:" />
                </PagerContent>
            </MudTable>
        </MudPaper>
    }
</MudContainer>

@code {
    private const string AllStatus = "all";
    private const string DoneStatus = "done";
    private const string PendingStatus = "pending";

    private readonly List<StudentTestItem> _testItems = [];
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _searchText = string.Empty;
    private string _statusFilter = AllStatus;

    private IEnumerable<StudentTestItem> FilteredTestItems => _testItems
        .Where(MatchesFilters)
        .OrderBy(item => item.FormationTitle)
        .ThenBy(item => item.ModuleTitle)
        .ThenBy(item => item.Test.Consigne);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var inscriptions = await Http.GetFromJsonAsync<List<InscriptionDTO>>("api/inscriptions/me") ?? [];

            foreach (var inscription in inscriptions)
            {
                var formation = await Http.GetFromJsonAsync<FormationDTO>($"api/formation/{inscription.FormationId}");
                if (formation is null)
                {
                    continue;
                }

                var rendus = await Http.GetFromJsonAsync<List<RenduTestDTO>>($"api/rendutests/inscription/{inscription.Id}") ?? [];
                var modules = formation.Modules?.OrderBy(module => module.Ordre).ToList() ?? [];

                foreach (var module in modules)
                {
                    foreach (var test in (module.Tests ?? Enumerable.Empty<TestDTO>()).OrderBy(test => test.Id))
                    {
                        _testItems.Add(new StudentTestItem(
                            inscription.FormationId,
                            DisplayOrDash(formation.Titre),
                            DisplayOrDash(module.Titre),
                            test,
                            rendus.FirstOrDefault(rendu => rendu.TestId == test.Id)));
                    }
                }
            }
        }
        catch
        {
            _errorMessage = "Impossible de charger la liste de vos tests.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool MatchesFilters(StudentTestItem item)
    {
        var matchesStatus = _statusFilter switch
        {
            DoneStatus => item.Rendu is not null,
            PendingStatus => item.Rendu is null,
            _ => true
        };

        if (!matchesStatus)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_searchText))
        {
            return true;
        }

        return new[]
        {
            item.FormationTitle,
            item.ModuleTitle,
            item.Test.Consigne
        }.Any(value => value?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) == true);
    }

    private static string FormatNote(float? note)
        => note.HasValue ? $"{note:0.##}/20" : "-";

    private static string DisplayOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private sealed record StudentTestItem(
        int FormationId,
        string FormationTitle,
        string ModuleTitle,
        TestDTO Test,
        RenduTestDTO? Rendu);
}
